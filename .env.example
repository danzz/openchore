# OpenChore Configuration Example

# --- Database Configuration ---
# By default, OpenChore uses SQLite (stored at openchore.db).
# To enable PostgreSQL, specify POSTGRES_HOST or DATABASE_URL, or set DB_TYPE=postgres.
DB_TYPE=postgres
POSTGRES_HOST=192.168.199.11
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=asb@1234
POSTGRES_DATABASE=openchore
POSTGRES_SSLMODE=disable

# Alternatively, configure via standard DATABASE_URL:
# DATABASE_URL=postgres://admin:asb%401234@192.168.199.11:5432/openchore?sslmode=disable

# SQLite settings (only used when DB_TYPE=sqlite or POSTGRES_* is unset)
# DB_PATH=openchore.db

# --- Server Configuration ---
PORT=8080
CONFIG_PATH=config/config.yaml
# OPENCHORE_SESSION_SECRET=your-random-32-byte-secret

# --- AI & TTS Configuration (Optional) ---
# AI_BASE_URL=http://localhost:8081/v1
# AI_MODEL=gemma-4-e4b
# AI_API_KEY=
# TTS_BASE_URL=http://localhost:8880/v1
# TTS_MODEL=kokoro
# TTS_API_KEY=
